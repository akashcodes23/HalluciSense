# ─────────────────────────────────────────────────────────────────────────────
# HalluciSense Frontend Environment Variables (Vercel Deployment)
# ─────────────────────────────────────────────────────────────────────────────

# Canonical Backend API Base URL
# Local:      http://localhost:8000
# Preview:    https://hallucisense-production.up.railway.app
# Production: https://hallucisense-production.up.railway.app
NEXT_PUBLIC_API_BASE_URL=https://hallucisense-production.up.railway.app

# Optional legacy alias (auto-fallback in services if NEXT_PUBLIC_API_BASE_URL is set)
NEXT_PUBLIC_API_URL=https://hallucisense-production.up.railway.app

# Environment & Build Metadata
NEXT_PUBLIC_APP_ENV=production
NEXT_PUBLIC_VERSION=1.0.0
NEXT_PUBLIC_BUILD_SHA=main